{
  "rules": {
    "players": {
      ".read": true,
      ".indexOn": [
        "best"
      ],
      "$uid": {
        "seen": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        },
        "active": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        },
        "st": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 40"
        }
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "clock": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "queue": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && data.child('at').val() < now - 60000))"
      }
    },
    "matches": {
      ".read": "auth != null",
      ".indexOn": [
        "created"
      ],
      "$mid": {
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid || (!newData.exists() && data.child('created').val() < now - 3600000))",
        "live": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "broadcast": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'Jj2BGaR4ZBSqqQxmWtX8Vym95Ji1'"
    },
    "grants": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === 'Jj2BGaR4ZBSqqQxmWtX8Vym95Ji1'"
      }
    },
    "vault": {
      ".read": false,
      ".write": false
    },
    "meta": {
      ".read": true,
      "shop": {
        ".write": "auth != null && auth.uid === 'Jj2BGaR4ZBSqqQxmWtX8Vym95Ji1'"
      }
    },
    "realnames": {
      ".read": "auth != null && auth.uid === 'Jj2BGaR4ZBSqqQxmWtX8Vym95Ji1'",
      ".write": "auth != null && auth.uid === 'Jj2BGaR4ZBSqqQxmWtX8Vym95Ji1'"
    },
    "secret": {
      ".read": "auth != null && auth.uid === 'Jj2BGaR4ZBSqqQxmWtX8Vym95Ji1'",
      ".write": "auth != null && auth.uid === 'Jj2BGaR4ZBSqqQxmWtX8Vym95Ji1'"
    },
    "troll": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === 'Jj2BGaR4ZBSqqQxmWtX8Vym95Ji1'"
      }
    },
    "trollpics": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'Jj2BGaR4ZBSqqQxmWtX8Vym95Ji1'"
    },
    "feedback": {
      ".read": "auth != null && auth.uid === 'Jj2BGaR4ZBSqqQxmWtX8Vym95Ji1'",
      ".indexOn": [
        "at"
      ],
      "$id": {
        ".write": "(auth != null && !data.exists() && newData.child('uid').val() === auth.uid) || (auth != null && auth.uid === 'Jj2BGaR4ZBSqqQxmWtX8Vym95Ji1')",
        ".validate": "!newData.exists() || (newData.child('text').isString() && newData.child('text').val().length <= 1000)"
      }
    },
    "visits": {
      ".read": "auth != null && auth.uid === 'Jj2BGaR4ZBSqqQxmWtX8Vym95Ji1'",
      "$day": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}